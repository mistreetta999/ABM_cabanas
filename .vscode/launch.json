{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "--skip-checks"
      ],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": true,
      "autoReload": {
        "enable": true
      }
    },
    {
      "name": "Django: Check",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["check"],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
