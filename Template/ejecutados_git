Write-Host "🔄 Borrando caches de Python/Django..."

# Eliminar carpetas __pycache__ y archivos .pyc
Get-ChildItem -Path . -Include "__pycache__", "*.pyc", "*.pyo" -Recurse | Remove-Item -Recurse -Force

# Eliminar migraciones (excepto __init__.py)
Get-ChildItem -Path . -Recurse -Include "*.py" | Where-Object { $_.DirectoryName -like "*\migrations" -and $_.Name -ne "__init__.py" } | Remove-Item -Force

# Limpiar cache de pip
pip cache purge

